# Copy to deploy/compose/.env.prod and fill in real values. Never commit it.
#
#   cp deploy/compose/.env.prod.example deploy/compose/.env.prod
#
# `docker compose --env-file` reads this file for interpolation, so the required
# values below must be set before `up`.

ENV=prod
LOG_LEVEL=INFO

# ---- Edge -------------------------------------------------------------------
# A hostname enables automatic HTTPS in Caddy. Leave :80 for plain HTTP.
BLACKBOX_DOMAIN=:80
# Comma-separated list. Required by the browser only if you use the bundled viewer
# from another origin.
CORS_ORIGINS=

# ---- Auth (required in prod) ------------------------------------------------
# HS256 for a small deployment; use AUTH_JWKS_URL + issuer/audience for an OIDC IdP.
AUTH_JWT_SECRET=replace-with-openssl-rand-hex-32
# AUTH_JWKS_URL=
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=
AUTH_DEFAULT_TENANT=default

# ---- Provider (required) ----------------------------------------------------
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
GENERATION_MODEL=gpt-4o
GRADING_MODEL=gpt-4o-mini
REWRITE_MODEL=gpt-4o-mini

# ---- Data stores ------------------------------------------------------------
# Managed services (default): point these at your provider.
DATABASE_URL=postgresql://user:password@db.example.com:5432/blackbox
REDIS_URL=rediss://:password@redis.example.com:6379/0

# Local override (docker-compose.prod-local.yml): use the compose service names.
# DATABASE_URL=postgresql://blackbox:change-me@postgres:5432/blackbox
# REDIS_URL=redis://redis:6379/0
# POSTGRES_PASSWORD=change-me
# POSTGRES_USER=blackbox
# POSTGRES_DB=blackbox

# Postgres RLS requires a non-owner role. Enable after the role is provisioned.
RLS_ENABLED=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true

# ---- Scale-out retrieval (recommended above one API replica) -----------------
# Chroma/BM25 are node-local. For more than one API replica, point the dense and
# sparse legs at external stores and set retrieval.dense_backend / sparse_backend
# in blackbox/config/config.yaml.
# QDRANT_URL=https://qdrant.internal:6333
# OPENSEARCH_HOSTS=https://search.internal:9200
# OPENSEARCH_ALIAS=blackbox_chunks

# ---- Limits and isolation ---------------------------------------------------
# Caddy is the trusted peer; this is the default Docker bridge range. Replace it
# with the actual compose network subnet if you changed it.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
TENANT_QUOTA_ENABLED=true
TENANT_QUOTA_TOKENS_PER_DAY=1000000
TENANT_QUOTA_LLM_CALLS_PER_DAY=1000
TENANT_BUDGET_USD_PER_DAY=0
TENANT_CONCURRENCY_GLOBAL=true

# ---- Regions (single region by default) -------------------------------------
REGION=local
DEFAULT_HOME_REGION=local
REGION_WRITE_PINNING=false

# ---- Observability (optional) -----------------------------------------------
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# SENTRY_DSN=

# ---- Trace archive (optional) -----------------------------------------------
# TRACE_ARCHIVE_BACKEND=s3
# TRACE_ARCHIVE_BUCKET=blackbox-traces
# TRACE_ARCHIVE_REGION=us-east-1

# ---- Replicas ---------------------------------------------------------------
API_REPLICAS=2
WORKER_REPLICAS=1
