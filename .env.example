# Copy to .env and fill in real values. Never commit .env.
ENV=dev
LOG_LEVEL=INFO
LLM_PROVIDER=openai

# LLM provider keys (set the one you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Data stores
DATABASE_URL=postgresql://blackbox:blackbox@postgres:5432/blackbox
REDIS_URL=redis://redis:6379/0
CHROMA_PERSIST_DIR=/app/data/chroma

# Models
EMBEDDING_MODEL=text-embedding-3-small
# Optional override of retrieval.embedding_provider: auto|openai|onnx|fake|sentence_transformer
# EMBEDDING_PROVIDER=auto
GENERATION_MODEL=gpt-4o
GRADING_MODEL=gpt-4o-mini
REWRITE_MODEL=gpt-4o-mini
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Hosted LLM call policy
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8
LLM_CIRCUIT_THRESHOLD=5
LLM_CIRCUIT_RESET_S=30

# Worker threads for the blocking parts of the request path (Chroma, BM25, SQLAlchemy).
# The asyncio default is min(32, cpu_count + 4), which ties concurrency to the host.
MAX_WORKER_THREADS=32

# Config
CONFIG_PATH=blackbox/config/config.yaml

# CORS (comma-separated; empty disables. Never use "*" in prod)
CORS_ORIGINS=

# Authentication (required in prod). Use a JWKS URL for RS256 in production.
AUTH_ENABLED=false
AUTH_JWT_SECRET=
AUTH_JWKS_URL=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_DEFAULT_TENANT=default

# Trusted reverse proxies (comma-separated CIDRs).
# X-Forwarded-For is only honoured for requests arriving from these networks. Without
# this, every request behind an ingress shares one rate-limit bucket. Leave empty when
# the app is exposed directly.
TRUSTED_PROXY_CIDRS=

# OpenSearch, the sparse retrieval backend that scales past a single pod.
# The backend itself is chosen in the YAML config: retrieval.sparse_backend (bm25|opensearch).
OPENSEARCH_HOSTS=
OPENSEARCH_INDEX=blackbox_chunks
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true

# Cold trace storage. `none` disables archiving (retention then prunes without
# preserving); `file` writes gzipped JSONL batches under TRACE_ARCHIVE_DIR; `s3`
# writes them to TRACE_ARCHIVE_BUCKET (install the `archive` extra for boto3).
# Retention is `POST /api/admin/retention?days=90&archive=true`.
TRACE_ARCHIVE_BACKEND=none
TRACE_ARCHIVE_DIR=./data/traces
TRACE_ARCHIVE_BUCKET=
TRACE_ARCHIVE_PREFIX=traces
TRACE_ARCHIVE_REGION=

# Optional distributed tracing. Install the `otel` extra, then point the OTLP/HTTP
# exporter at a collector (deploy/observability). Disabled means the facade is a no-op.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=blackbox-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_TIMEOUT_S=10
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_IGNORE_PATHS=/health,/health/ready,/metrics

# Global per-tenant LLM/token quotas (disabled by default; needs a shared Redis).
TENANT_QUOTA_ENABLED=false
TENANT_QUOTA_TOKENS_PER_DAY=1000000
TENANT_QUOTA_LLM_CALLS_PER_DAY=1000
